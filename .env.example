# Last Mile Stabilizer - Environment Configuration
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=last_mile_stabilizer
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5432/last_mile_stabilizer

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# AI Configuration
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4-turbo-preview
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000

# Optional: Anthropic
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key
# AI_MODEL=claude-3-opus-20240229

# Storage
PROJECT_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500
ALLOWED_ARCHIVE_EXTENSIONS=.zip,.tar,.tar.gz,.tgz

# Docker Sandbox
DOCKER_ENABLED=true
DOCKER_CPU_LIMIT=1.0
DOCKER_MEMORY_LIMIT=512m
DOCKER_TIMEOUT_SECONDS=120
DOCKER_NETWORK_DISABLED=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (optional)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# App
APP_NAME=Last Mile Stabilizer
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000